{
  "permissions": {
    "allow": ["Bash(git *)", "Bash(npm *)", "Bash(npx *)"],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(rm -rf*)",
      "Bash(rm -fr*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.test)",
      "Read(**/.env.postgres)",
      "Read(**/.env.development)",
      "Read(**/.env.production)"
    ]
  }
}
